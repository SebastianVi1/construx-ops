# Dev gateway, rendered by the nginx image's envsubst step into /etc/nginx/conf.d/default.conf.
# Only NGINX_* variables are substituted (NGINX_ENVSUBST_FILTER); nginx's own $variables stay as-is.
# Values come from docker-compose.dev.yml, which reads them from the root .env.

# Vite and Astro hot reload use websockets
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Docker's embedded DNS. Upstreams are held in variables so nginx resolves them per request:
# it starts even if a service is down and recovers after `restart backend`.
resolver 127.0.0.11 valid=10s ipv6=off;

# Dashboard host: SPA dev server plus the backend on the same origin, mirroring the prod nginx
server {
    listen 80;
    server_name ${NGINX_DASHBOARD_HOST};

    # Above the backend's 2 MB multipart limit so it returns its own validation error
    client_max_body_size 5m;

    # API plus the Spring Security OAuth2 login endpoints
    location ~ ^/(api|oauth2|login/oauth2)/ {
        set $backend http://${NGINX_BACKEND_UPSTREAM};
        proxy_pass $backend;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        # Overwrite, never append: the backend rate-limits per client and trusts this header
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $http_host;
    }

    location / {
        set $dashboard http://${NGINX_DASHBOARD_UPSTREAM};
        proxy_pass $dashboard;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }
}

# Landing host; also the default for any unmatched Host header
server {
    listen 80 default_server;
    server_name ${NGINX_LANDING_HOST};

    location / {
        set $landing http://${NGINX_LANDING_UPSTREAM};
        proxy_pass $landing;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }
}
