# Production gateway, rendered by the nginx image's envsubst step into /etc/nginx/conf.d/default.conf.
# Only NGINX_* variables are substituted (NGINX_ENVSUBST_FILTER); nginx's own $variables stay as-is.
# Values come from docker-compose.prod.yml, which reads them from the root .env.

# Docker's embedded DNS. Upstreams are held in variables so nginx resolves them per request:
# it starts even if a service is down and recovers after a restart.
resolver 127.0.0.11 valid=10s ipv6=off;

# Plain HTTP only answers Let's Encrypt challenges; everything else moves to HTTPS
server {
    listen 80 default_server;
    server_name _;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# Dashboard host: SPA plus the backend on the same origin, so auth cookies and CSRF work without CORS
server {
    listen 443 ssl;
    http2 on;
    server_name ${NGINX_DASHBOARD_HOST};
    include /etc/nginx/tls.conf;

    # Above the backend's 2 MB multipart limit so it returns its own validation error
    client_max_body_size 5m;

    # API plus the Spring Security OAuth2 login endpoints; Spring Security sets its own security headers
    location ~ ^/(api|oauth2|login/oauth2)/ {
        set $backend http://${NGINX_BACKEND_UPSTREAM};
        proxy_pass $backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # Overwrite, never append: the backend rate-limits per client and trusts this header
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
    }

    # The dashboard image's own nginx serves the bundle and sets caching and security headers
    location / {
        set $dashboard http://${NGINX_DASHBOARD_UPSTREAM};
        proxy_pass $dashboard;
        proxy_set_header Host $host;
    }
}

# Landing host; also the default for any unmatched SNI name
server {
    listen 443 ssl default_server;
    http2 on;
    server_name ${NGINX_LANDING_HOST};
    include /etc/nginx/tls.conf;

    location / {
        set $landing http://${NGINX_LANDING_UPSTREAM};
        proxy_pass $landing;
        proxy_set_header Host $host;
    }
}
