# Copy to docker.env and fill in the values. Shared by the db and backend services.
# Inside Docker the database host is the "db" service, not localhost.

# PostgreSQL container
POSTGRES_DB=construx
POSTGRES_USER=construx
POSTGRES_PASSWORD=change-me

# Backend datasource (must match the values above)
DB_URL=jdbc:postgresql://db:5432/construx
DB_USERNAME=construx
DB_PASSWORD=change-me

# Public URL of the dashboard: http://app.localhost in dev (the dev overlay sets it from DASHBOARD_PUBLIC_URL), the prod overlay sets it to https://DASHBOARD_HOST
FRONTEND_URL=http://app.localhost

# Base64-encoded secret of 32+ bytes, e.g. `openssl rand -base64 32`
JWT_SECRET=
JWT_ISSUER=construx
JWT_AUDIENCE=construx-api

# Google OAuth client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Time zone that decides which calendar day "today" is (zone assignments, floor plan state, Attendance), as an IANA
# region name. Defaults to America/Mexico_City when unset; an unknown or empty name stops the backend at startup
APP_TIME_ZONE=America/Mexico_City

# Outgoing mail
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Plan uploads (optional; without a bucket the app starts but uploads fail)
AWS_REGION=us-east-1
AWS_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# WhatsApp Cloud API for Field updates (optional; without them the backend starts, the webhook at
# /api/webhooks/whatsapp refuses every call and the bot sends nothing). From the Meta app's WhatsApp settings:
# WHATSAPP_PHONE_NUMBER_ID is the id of the Construx number, WHATSAPP_ACCESS_TOKEN a system-user token,
# WHATSAPP_APP_SECRET the app secret that signs webhook posts, WHATSAPP_VERIFY_TOKEN any random string you also
# enter in Meta's webhook setup, and WHATSAPP_DISPLAY_NUMBER the Construx number shown in the dashboard (+15551234567).
# WHATSAPP_GRAPH_API_URL is optional; leave it commented out to use the default below
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_DISPLAY_NUMBER=
# WHATSAPP_GRAPH_API_URL=https://graph.facebook.com/v23.0

# Dev only: shared password of the seeded demo accounts (construx.demo.password, used by the demo profile that
# docker-compose.dev.yml enables). Leave empty to skip seeding. Pick your own; never reuse a real password.
CONSTRUX_DEMO_PASSWORD=
