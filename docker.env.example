# Copy to docker.env and fill in the values. Shared by the db and backend services.
# Inside Docker the database host is the "db" service, not localhost.

# PostgreSQL container
POSTGRES_DB=construx
POSTGRES_USER=construx
POSTGRES_PASSWORD=change-me

# Backend datasource (must match the values above)
DB_URL=jdbc:postgresql://db:5432/construx
DB_USERNAME=construx
DB_PASSWORD=change-me

# Public URL of the dashboard: http://localhost:5173 in dev, http://localhost:8081 or your domain in prod
FRONTEND_URL=http://localhost:5173

# Base64-encoded secret of 32+ bytes, e.g. `openssl rand -base64 32`
JWT_SECRET=
JWT_ISSUER=construx
JWT_AUDIENCE=construx-api

# Google OAuth client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Outgoing mail
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Plan uploads (optional; without a bucket the app starts but uploads fail)
AWS_REGION=us-east-1
AWS_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
