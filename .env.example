# Copy to .env. Compose reads this file for variable substitution (hosts, ports, build args).
# Secrets for the containers go in docker.env, not here.

# --- Public hosts (nginx gateway) ---
# Dev: *.localhost resolves to 127.0.0.1 in browsers without /etc/hosts edits.
# Prod: required; real domains with DNS records pointing at the server.
LANDING_HOST=localhost
DASHBOARD_HOST=app.localhost

# --- Dev only (docker-compose.dev.yml) ---
# Public dashboard URL as the browser sees it; include the port if NGINX_HTTP_PORT is not 80
DASHBOARD_PUBLIC_URL=http://app.localhost

# --- Prod only (docker-compose.prod.yml) ---
# Let's Encrypt account email (required in prod); set STAGING=1 to test without rate limits
LETSENCRYPT_EMAIL=
LETSENCRYPT_STAGING=0
# Optional build args for the dashboard image
VITE_OAUTH2_AUTHORIZATION_URL=
VITE_HANDSONTABLE_LICENSE=

# --- Optional gateway overrides (leave unset for the defaults) ---
# Upstreams as host:port. Defaults: backend:8080, dashboard:5173 / landing:4321 in dev,
# dashboard:80 / landing:80 in prod. Use an IP or host.docker.internal:<port> (dev) to reach
# a process running outside Docker.
# BACKEND_UPSTREAM=
# DASHBOARD_UPSTREAM=
# LANDING_UPSTREAM=
# Interface and ports nginx is published on. Defaults: 127.0.0.1 in dev, 0.0.0.0 in prod; 80 and 443.
# NGINX_BIND_IP=
# NGINX_HTTP_PORT=
# NGINX_HTTPS_PORT=
