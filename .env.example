# Copy to .env. Compose reads this file for variable substitution (ports, hosts, build args).
# Secrets for the containers go in docker.env, not here. Every value below is optional.

# --- Dev gateway (docker-compose.dev.yml, nginx service) ---
# Hostnames nginx routes on. *.localhost resolves to 127.0.0.1 in browsers without /etc/hosts edits.
LANDING_HOST=localhost
DASHBOARD_HOST=app.localhost
# Public dashboard URL as the browser sees it; include the port if NGINX_HTTP_PORT is not 80
DASHBOARD_PUBLIC_URL=http://app.localhost
# Upstreams as host:port. Compose service names by default; use an IP or
# host.docker.internal:<port> to reach a process running outside Docker.
BACKEND_UPSTREAM=backend:8080
DASHBOARD_UPSTREAM=dashboard:5173
LANDING_UPSTREAM=landing:4321
# Interface and port nginx is published on (0.0.0.0 exposes it on the LAN)
NGINX_BIND_IP=127.0.0.1
NGINX_HTTP_PORT=80

# --- Prod overlay (docker-compose.prod.yml) ---
DASHBOARD_PORT=8081
LANDING_PORT=8082
VITE_OAUTH2_AUTHORIZATION_URL=
VITE_HANDSONTABLE_LICENSE=
